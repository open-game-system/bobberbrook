{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Command runner on purpose: Stryker's vitest runner never activates mutants under vitest 5. tsconfigFile points at a missing file: TypeScript 7 has no JS API for Stryker's tsconfig rewrite, and vitest doesn't need it. Reports land in coverage/ (gitignored).",
  "testRunner": "command",
  "commandRunner": { "command": "node node_modules/vitest/vitest.mjs run --bail=1 src/game src/room.machine.test.ts" },
  "mutate": ["src/game/**/*.ts", "!src/**/*.test.ts"],
  "ignorePatterns": [".claude", "recordings", "assets-src", "assets", "public", "concept", "critic", ".wrangler", "certs", "coverage", "docs"],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "disableTypeChecks": true,
  "checkers": [],
  "coverageAnalysis": "off",
  "tempDirName": "coverage/.stryker-tmp",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "coverage/mutation/mutation.json" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "concurrency": 10,
  "timeoutMS": 30000
}
